# Server Port
PORT=5000

# Database Mode:
# Set to 'true' to use local MongoDB (mongodb://127.0.0.1:27017/taskmanager)
# Set to 'false' to connect to MongoDB Atlas
USE_LOCAL_DB=true

# Local MongoDB Connection String (Fallback)
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/taskmanager

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskmanager?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key for token signing
JWT_SECRET=taskmanager_super_secret_jwt_key_2026_change_in_production
